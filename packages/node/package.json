{
  "name": "@openvoid/node",
  "version": "0.1.0",
  "description": "Run Void apps on Node.js with your own database, key-value store, and object storage. No Cloudflare account required.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blbaker/openvoid.git",
    "directory": "packages/node"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./fga": {
      "types": "./dist/fga/index.d.ts",
      "import": "./dist/fga/index.js"
    },
    "./bindings": {
      "types": "./dist/bindings/index.d.ts",
      "import": "./dist/bindings/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --no-warnings --test 'test/**/*.test.ts'"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "void": ">=1.1.11 <2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@hono/node-server": "^2.1.5",
    "@openfga/sdk": "^0.9.7",
    "@openfga/syntax-transformer": "^0.2.2",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "void": "1.1.11"
  }
}
